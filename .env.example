# Upstage Studio Agent API (서버 전용 — NEXT_PUBLIC_ 접두사 금지)
UPSTAGE_API_KEY=up_xxxxxxxxxxxxxxxxxxxx
UPSTAGE_PROJECT_ID=proj_xxxxxxxxxxxxxxxxxxxx
UPSTAGE_AGENT_ID=agt_xxxxxxxxxxxxxxxxxxxx
UPSTAGE_CONFIG_ID=7
# true면 Upstage를 호출하지 않고 mock/response.json으로 흐름을 재현
DEMO_MODE=false
# 설정하면 사이트 전체에 비밀번호(브라우저 로그인 창)를 건다. 비워 두면 공개.
APP_PASSWORD=
# 업로드 한도(MB). 비워 두면 Vercel은 4, 그 외는 50.
MAX_UPLOAD_MB=
